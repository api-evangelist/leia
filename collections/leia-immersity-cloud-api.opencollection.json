            "name": "Stereo Top-Bottom",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.immersity.ai/api/v1/topBottom",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
