{
  "opencollection": "1.0.0",
  "info": {
    "name": "Immersity Cloud API",
    "version": "3.1.1"
  },
  "items": [
    {
      "info": {
        "name": "Product Pricing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get prices for all products",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.immersity.ai/api/v1/prices",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This endpoint returns prices for all products"
        }
      ]
    },
    {
      "info": {
        "name": "Media Transformation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Disparity Map",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.immersity.ai/api/v1/disparity",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Historically, a disparity map is a visual representation of the differences in pixel coordinates between the corresponding points in a stereo image pair. It is typically generated from a pair of stereo images taken from slightly different viewpoints (left and right cameras). Using the power of the Immersity Cloud API, you can now generate a disparity map for any standard 2D image."
        },
        {
          "info": {
            "name": "Animation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.immersity.ai/api/v1/animation",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This API allows you to generate a captivating 3D animation. By utilizing the input disparity map and a single image, this generates an immersive 3D animation that adds depth and realism to the image."
        },
        {
          "info": {
            "name": "TransactionController_transactionCallback",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.immersity.ai/api/v1/transaction/callback",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
