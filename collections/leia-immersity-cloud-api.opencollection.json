            }
          },
          "docs": "Stereo Top-Bottom"
        },
        {
          "info": {
            "name": "LIF Decoder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.immersity.ai/api/v1/decode",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This API allows you to decode a LIF file into a 2D image."
        },
        {
          "info": {
            "name": "LIF Encoder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.immersity.ai/api/v1/encode",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This API allows you to encode a 2D image into a LIF file."
        },
        {
          "info": {
            "name": "2D to 3D Video Conversion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.immersity.ai/api/v1/video",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This API allows you to convert a 2D video into 3D video. This service is an asynchronous only service, so despites it returns a 200 OK with resultPresignedUrl, the video will be available only after the conversion is done. The client must provide a custom callback URL to be notified when the conversion is done. Callback payload can include error code and error message."
        },
        {
          "info": {
            "name": "Convert video to Apple Vision Spatial",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.immersity.ai/api/v1/spatial",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "This API allows you to convert a video into Apple Vision Spatial video. This service is an asynchronous only service, so despites it returns a 200 OK with resultPresignedUrl, the video will be available only after the conversion is done. The client must provide a custom callback URL to be notified when the conversion is done. Callback payload can include error code and error message."
        }
      ]
    },
    {
      "info": {
        "name": "Storage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Presigned URL",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.immersity.ai/api/v1/get-upload-url",
            "params": [
              {
                "name": "fileName",
                "value": "myFile.jpg",
                "type": "query",
                "description": "File name to upload"
              },
              {
                "name": "mediaType",
                "value": "image/jpeg",
                "type": "query",
                "description": "Mime type of the file to upload"
              },
              {
                "name": "correlationId",
                "value": "123e4567-e89b-12d3-a456-426614174000",
                "type": "query",
                "description": "Unique query identifier. If not provided, one will be generated"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a presigned URL for uploading a file to Leia Storage with 24hrs expiration"
        }
      ]
    }
  ],
  "bundled": true
}